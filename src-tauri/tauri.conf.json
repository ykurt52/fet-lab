{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FET Lab",
  "version": "1.0.0",
  "identifier": "com.yunuskurt.fetlab",
  "build": {
    "frontendDist": "../build/web",
    "beforeBuildCommand": "python tools/export_site.py build/web"
  },
  "app": {
    "windows": [
      {
        "title": "FET Lab",
        "width": 1280,
        "height": 860,
        "minWidth": 380,
        "minHeight": 500,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Yunus Kurt",
    "copyright": "Copyright (c) 2026 Yunus Kurt",
    "license": "MIT",
    "category": "Education",
    "shortDescription": "Interactive transistor and MOSFET driving lab",
    "longDescription": "FET Lab teaches how to drive BJTs and MOSFETs from a microcontroller or FPGA: a circuit simulator with real parts, gate drive, flyback, inrush, overcurrent, thermal design, application circuits and a quiz. Turkish and English.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
